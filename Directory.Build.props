<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Test-only and internal naming rules that are noise for this codebase -->
    <NoWarn>$(NoWarn);CA1707;CA1848;CA1515;CA2007;CA1062;CA1716;CA1032;CA1873</NoWarn>
  </PropertyGroup>
</Project>
