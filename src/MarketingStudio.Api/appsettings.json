{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Mongo": {
    "ConnectionString": "mongodb://mongodb:27017/?replicaSet=rs0",
    "Database": "marketingstudio"
  },
  "Jwt": {
    "Issuer": "https://app.marketingstudio.ai",
    "Audience": "marketingstudio-api",
    "AccessTokenMinutes": 15,
    "SigningKeyPath": "/run/secrets/jwt_signing_key",
    "CreateKeyIfMissing": false
  },
  "RefreshTokens": {
    "LifetimeDays": 7,
    "AbsoluteSessionDays": 30
  },
  "App": {
    "PortalBaseUrl": "https://app.marketingstudio.ai"
  },
  "Email": {
    "SmtpHost": "",
    "From": "AI Marketing Studio <no-reply@marketingstudio.ai>"
  },
  "DataProtection": {
    "KeysPath": "/var/lib/marketingstudio/dataprotection-keys"
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 10
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Storage": {
    "ServiceUrl": "http://seaweedfs:8333",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "marketingstudio",
    "Region": "us-east-1"
  },
  "Qdrant": {
    "Url": "http://qdrant:6333",
    "ApiKey": ""
  },
  "Embeddings": {
    "Provider": "Ollama",
    "Model": "nomic-embed-text",
    "BaseUrl": "http://ollama:11434",
    "Dimensions": 768
  },
  "VirusScan": {
    "Provider": "ClamAV",
    "Host": "clamav",
    "Port": 3310
  },
  "Knowledge": {
    "MinScore": 0.5
  }
}
