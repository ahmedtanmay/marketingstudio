<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <!-- Inline arrays in test data are fine; the performance hint only adds noise in tests. -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>
</Project>
